# Production API URL — used when VITE_API_URL is not set during build.
# Leave empty for local dev (Vite proxy handles /api).
VITE_API_URL=

# Local dev: where Vite should proxy /api requests.
# Default: http://127.0.0.1:4000 (local backend)
# To develop frontend against the deployed Railway backend:
#   VITE_DEV_PROXY_TARGET=https://printflow-production-bb78.up.railway.app
VITE_DEV_PROXY_TARGET=http://127.0.0.1:4000

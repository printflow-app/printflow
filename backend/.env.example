# PrintFlow Backend — Environment Variables
# =============================================
# MUHIM: Bu fayl .gitignore da bo'lishi SHART!
# Hech qachon real qiymatlarni git'ga push qilmang!
# =============================================

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/printflow_db?schema=public"

# JWT Secrets — ikki xil secret (tenant vs super-admin)
# MUHIM: Production da random 64-char string ishlatilsin
# Gen: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_USE_LONG_RANDOM_STRING_FOR_TENANT_TOKENS"
SUPER_ADMIN_SECRET="CHANGE_ME_DIFFERENT_LONG_RANDOM_STRING_FOR_SUPERADMIN"

# App
NODE_ENV="development"
PORT=4000

# CORS — vergul bilan ajratilgan ruxsat etilgan domenlar
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000"

# Seed credentials (only used by prisma/seed.ts)
SUPER_ADMIN_EMAIL="admin@printflow.uz"
SUPER_ADMIN_PASSWORD="CHANGE_ME_BEFORE_SEEDING"
DEMO_TENANT_SLUG="demo"
DEMO_ADMIN_LOGIN="admin"
DEMO_ADMIN_PASSWORD="CHANGE_ME_BEFORE_SEEDING"

# Telegram Bot — Tenant xodimlari uchun bildirishnoma boti
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Support Bot — Mijoz murojaatlarini super-adminga yuboradi
# SUPPORT_BOT_ADMIN_CHAT_IDS — vergul bilan ajratilgan Telegram chat ID'lari
# (super-admin /myid komandasini ishlatib o'z ID'sini olishi mumkin)
SUPPORT_BOT_TOKEN="your_support_bot_token_here"
SUPPORT_BOT_ADMIN_CHAT_IDS=""

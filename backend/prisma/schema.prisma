// PrintFlow Multi-Tenant SaaS — Database Schema
// Migration from: Sharq Admin (single-tenant) → PrintFlow (multi-tenant)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// PLATFORM LEVEL — Super-Admin scope
// =============================================

enum TenantStatus {
  TRIAL
  ACTIVE
  EXPIRED
  PENDING_PAYMENT
}

// Dynamic Plans — Super-Admin manages from panel
model Plan {
  id                  String   @id @default(uuid())
  name                String   @unique // "STARTER", "STANDARD", "INDUSTRIAL"
  displayName         String // "Starter (Kichik)"
  price3m             Float    @default(0) // 3 oylik narx
  price6m             Float    @default(0) // 6 oylik narx
  price12m            Float    @default(0) // 12 oylik narx
  maxEmployees        Int      @default(8) // Xodimlar limiti (0 = cheksiz)
  maxBranches         Int      @default(1) // Filiallar limiti (0 = cheksiz)
  maxDepartments      Int      @default(1) // Bo'limlar limiti (0 = cheksiz)
  aiMessagesPerMonth  Int      @default(100) // AI xabarlar/30-kunlik davr limiti (0 = cheksiz)
  allowedModules      String[] // ['finance','kanban','inventory','reports','ai_chat']
  features            String   @default("{}") // JSON: { "kanban": true, "finance": false, ... }
  description         String? // Qisqa ta'rif
  isPopular           Boolean  @default(false) // Eng ommabop — highlight qilish
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  durationDays        Int      @default(30) // Obuna muddati kunlarda (30, 90, 180, 365)
  tenants             Tenant[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// AI foydalanish hisobi — har 30 kunlik davr uchun bitta satr.
// periodStart = tenant obunasidagi joriy 30-kunlik davrning boshlanish sanasi.
model AiUsage {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodStart  DateTime // 30-kunlik davr boshlanishi (yengil indeks uchun normalize'lashtirilgan)
  count        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, periodStart])
  @@index([tenantId])
}

model Tenant {
  id                 String       @id @default(uuid())
  name               String
  slug               String       @unique
  status             TenantStatus @default(TRIAL)
  isActive           Boolean      @default(true)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?

  // Plan relation
  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  // Obuna davomiyligi (oxirgi to'lov asosida)
  subscriptionDurationMonths Int? // 1, 3, 6, 12 — oxirgi tasdiqlangan to'lov muddati

  // Davomat — statik QR token (admin yaratadi va print qiladi)
  attendanceQrToken String? // null = hali generate qilinmagan

  // Relations to all tenant-scoped data
  roles             Role[]
  employees         Employee[]
  workspaceAdmins   WorkspaceAdmin[]
  customers         Customer[]
  customerContacts  CustomerContact[]
  vendors           Vendor[]
  orderVendorCosts  OrderVendorCost[]
  vendorLedgerEntries VendorLedgerEntry[]
  paymentTypes      PaymentType[]
  transactions      Transaction[]
  expenseTypes      ExpenseType[]
  kanbanColumns     KanbanColumn[]
  tasks             Task[]
  taskHistories     TaskHistory[]
  services          Service[]
  serviceOptions    ServiceOption[]
  serviceMaterials  ServiceMaterial[]
  materials         Material[]
  stockMovements    StockMovement[]
  attendanceRecords AttendanceRecord[]
  overtimeRequests  OvertimeRequest[]
  systemSettings    SystemSetting[]
  botSessions       BotSession[]
  payments          Payment[]
  branches          Branch[]
  promoCode         PromoCode? // Tenant'ning o'z referral kodı
  promoCodeUsages   PromoCodeUsage[] // Bu tenant boshqa kodni ishlatgan holatlari
  taskExpenses      TaskExpense[]
  vendorOrders      VendorOrder[]
  taskAttachments   TaskAttachment[]
  aiUsages          AiUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
}

// Bo'limlar (Departments) — Lightweight analytical tag for Tasks & Transactions only.
// NOT used for role hierarchy, employee assignment, or routing. Pure reporting label.
model Department {
  id        String   @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String? // null = workspace-wide / bosh ofis; non-null = scoped to one branch
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks        Task[]
  transactions Transaction[]

  // Department names are unique PER BRANCH (not per tenant) so two branches
  // can each have a "Bosma" department.
  @@unique([tenantId, branchId, name])
  @@index([tenantId])
  @@index([branchId])
}

model SuperAdmin {
  id           String   @id @default(uuid())
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// =============================================
// UserTabView — sidebar badge tizimi uchun.
// userId = Employee.id YOKI WorkspaceAdmin.id (bitta string maydon, FK YO'Q —
// chunki ikkala turi ham bo'lishi mumkin va schema'da diskriminator yo'q).
// (userId, tabId) juftligi unique — har user har tab uchun bitta yozuv.
// =============================================
model UserTabView {
  id           String   @id @default(uuid())
  userId       String // Employee.id YOKI WorkspaceAdmin.id
  tabId        String // 'kassa', 'topshiriqlar', 'mijozlar' va h.k.
  lastViewedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, tabId])
  @@index([userId])
}

// Workspace Owner/Director — has full access, NOT an Employee, never shows in assignee dropdowns
model WorkspaceAdmin {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fullName        String
  phone           String?
  login           String
  passwordHash    String // bcrypt hash
  telegramId      String?
  passwordVersion Int     @default(1)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, login])
  @@index([tenantId])
}

model PlatformSetting {
  id    String @id @default(uuid())
  key   String @unique // e.g. "PAYMENT_CARDS"
  value String // JSON string
}

model Payment {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planName       String // Plan nomi vaqtidagi snapshot
  duration       Int // Duration in months (3, 6, 12)
  amount         Float // To'langan summa (chegirmadan keyin)
  originalAmount Float? // Chegirmadan oldingi summa
  discountAmount Float     @default(0) // Promo kod chegirmasi
  sender         String // Yuboruvchi ism-familiyasi
  receiptUrl     String? // Chek/Kvitansiya rasmining URL
  notes          String? // Qo'shimcha izoh
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy     String? // Super-Admin ID
  approvedAt     DateTime?
  promoCodeUsed  String? // Ishlatilgan promo kod
  cashbackUsed   Float     @default(0) // Sarflangan cashback
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Leads from Landing Page
model DemoRequest {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  companyName  String
  role         String
  phone        String
  telegramUser String?
  status       String   @default("new")
  createdAt    DateTime @default(now())
}

// =============================================
// REFERRAL / PROMO CODE SYSTEM
// =============================================

model PromoCode {
  id              String           @id @default(uuid())
  code            String           @unique // Unikal promo kod (masalan: COMPANY123)
  tenantId        String           @unique // Egasi (1 ta tenant — 1 ta kod)
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashbackBalance Float            @default(0) // Foydalanish mumkin bo'lgan cashback
  totalEarned     Float            @default(0) // Jami ishlab topgan cashback
  totalReferrals  Int              @default(0) // Jami jalb qilgan foydalanuvchilar
  isActive        Boolean          @default(true)
  usages          PromoCodeUsage[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model PromoCodeUsage {
  id             String    @id @default(uuid())
  promoCodeId    String
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  usingTenantId  String // Kim ishlatgan
  usingTenant    Tenant    @relation(fields: [usingTenantId], references: [id], onDelete: Cascade)
  planName       String // Qaysi tarifga to'lov qilingan
  paymentAmount  Float // To'lov summasi
  discount       Float // Berilgan chegirma (10%)
  cashbackEarned Float // Kod egasiga berilgan cashback
  createdAt      DateTime  @default(now())
}

// =============================================
// BOT SESSION — Telegram chat_id → Tenant mapping
// =============================================

model BotSession {
  id                 String    @id @default(uuid())
  chatId             String    @unique // Telegram chat ID
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String? // NULL until authenticated
  step               String    @default("IDLE") // LANG | WORKSPACE | LOGIN | PASSWORD | IDLE | OVERTIME_AWAITING
  lang               String    @default("uz") // uz | kril
  loginAttempt       String? // Temporary login storage during auth flow
  overtimePromptDate String? // YYYY-MM-DD when bot prompted for overtime explanation
  overtimePromptedAt DateTime? // When the prompt was sent (for timeout)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// =============================================
// XIZMATLAR KATALOGI (Pricing Engine)
// =============================================

model Service {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Strict branch isolation — every Service belongs to exactly one Branch.
  // Null semantics removed: there is no "shared" or "main office" Service.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String
  description String?
  basePrice   Float   @default(0)
  unit        String  @default("dona") // dona, metr, m2, kg...
  isActive    Boolean @default(true)

  // Variant o'qlari (axes) — agar xizmat turli rang/o'lcham bilan kelsa.
  // Masalan futbolka: ["Rang", "O'lcham"] → buyurtma formasi shu axes'larga
  // input grid chiqaradi. Bo'sh array bo'lsa — buyurtmada variant rejimi yo'q.
  // @default([]) MAJBURIY: ustun mavjud (ma'lumotli) jadvalga qo'shilganda
  // PostgreSQL default'siz NOT NULL massivni rad etadi → `prisma db push` yiqiladi.
  variantAxes String[] @default([])

  // Price list uchun rasm — base64 data URL (kichiklashtirilgan, ~600px JPEG).
  // Tashqi storage yo'q (Railway disk persistent emas), DB'da @db.Text sifatida.
  imageUrl String? @db.Text

  options   ServiceOption[]
  materials ServiceMaterial[]
  tasks     Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
}

model ServiceOption {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name             String // Qog'oz turi, Rang, Kesish...
  value            String // A4, To'q ko'k, Ha...
  percentageMarkup Float  @default(0) // Bazaviy narxga nisbatan foiz
  priceAdd         Float  @default(0) // Asosiy narxga qo'shimcha (hisoblangan)

  createdAt DateTime @default(now())

  @@index([tenantId])
}

// =============================================
// OMBOR VA MATERIALLAR (Inventory / BOM)
// =============================================

model Material {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Filial scope — null = bosh ofis / barcha filiallar uchun umumiy material.
  // Kod allaqachon branchId filtrini ishlatardi, schema'da yo'q edi → har inventory
  // query Prisma "Unknown argument branchId" xatosi bilan tushardi.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name          String
  unit          String @default("dona") // dona, kg, litr, metr, m2...
  currentStock  Float  @default(0)
  reservedStock Float  @default(0) // Band qilingan (ajratilgan) miqdor
  minStock      Float  @default(0) // Minimum qoldiq (ogohlantirish uchun)

  movements StockMovement[]
  bom       ServiceMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
}

model StockMovement {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  type     String // 'kirim' | 'chiqim' | 'brak'
  quantity Float
  note     String?
  taskId   String? // Qaysi buyurtma bilan bog'liq (optional)
  task     Task?   @relation(fields: [taskId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model ServiceMaterial {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  normPerUnit Float @default(1) // 1 ta mahsulot uchun necha birlik material

  @@unique([serviceId, materialId])
  @@index([tenantId])
}

// =============================================
// DAVOMAT (Attendance)
// =============================================

// AttendanceToken is platform-level — not tenant-scoped (QR code generation)
model AttendanceToken {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  tenantId  String // Which tenant's attendance scan
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AttendanceRecord {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date     String // YYYY-MM-DD format
  checkIn  DateTime?
  checkOut DateTime?

  // Kechikish (minutlarda, 09:00 boshlanish vaqtidan)
  lateMinutes Int @default(0)

  // Ortiqcha ish (overtime) — admin tasdiqlagan dam olish/kechki ish vaqti (minut)
  overtimeMinutes Int @default(0)

  deviceId String?
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([tenantId])
}

// =============================================
// ORTIQCHA ISH SO'ROVLARI (Overtime Requests)
// Xodim bot orqali ortiqcha qolgan vaqtni izohlaydi,
// admin tasdiqlasa AttendanceRecord ga overtimeMinutes yoziladi.
// =============================================
model OvertimeRequest {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date    String // YYYY-MM-DD — qaysi kun uchun
  message String // Xodim Telegram orqali yozgan izoh
  minutes Int    @default(0) // Telegram bot prompt vaqtidan hisoblangan ortiqcha minut

  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedAt     DateTime?
  approvedBy     String? // Employee/WorkspaceAdmin id (audit)
  rejectedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([employeeId, date])
}

// =============================================
// FILIALLAR (Multi-Branch)
// =============================================

model Branch {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name              String
  address           String?
  phone             String?
  managerEmployeeId String? // Employee.id reference (soft, no FK to avoid circular)
  isActive          Boolean @default(true)

  employees     Employee[]
  tasks         Task[]         @relation("OriginBranch")
  executorTasks Task[]         @relation("ExecutorBranch")
  customers     Customer[]
  transactions  Transaction[]
  departments   Department[]
  services      Service[]
  vendors       Vendor[]
  vendorLedgerEntries VendorLedgerEntry[]
  roles         Role[]
  kanbanColumns KanbanColumn[]
  materials     Material[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

// =============================================
// ROLES & EMPLOYEES
// =============================================

model Role {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name String

  // Moliya ruxsatlari
  canViewFinance        Boolean @default(false)
  canAddIncome          Boolean @default(false)
  canAddExpense         Boolean @default(false)
  canViewTotalBalance   Boolean @default(false)
  canManagePaymentTypes Boolean @default(false)

  // Topshiriqlar (Xizmatlar) ruxsatlari
  canViewTasks     Boolean @default(false)
  canCreateTask    Boolean @default(false)
  canEditTask      Boolean @default(false)
  canDeleteTask    Boolean @default(false)
  canMoveTask      Boolean @default(false)
  canManageColumns Boolean @default(false)

  // Mijozlar ruxsatlari
  canViewCustomers   Boolean @default(false)
  canManageCustomers Boolean @default(false)

  // Ombor ruxsatlari
  canViewInventory   Boolean @default(false)
  canManageInventory Boolean @default(false)

  // Davomat ruxsatlari
  canViewAttendance    Boolean @default(false)
  canViewAllAttendance Boolean @default(false)
  canManageAttendance  Boolean @default(false)

  // Xizmatlar Katalogi ruxsatlari
  canViewServices   Boolean @default(false)
  canManageServices Boolean @default(false)

  // Xodimlar ruxsatlari
  canViewEmployees   Boolean @default(false)
  canManageEmployees Boolean @default(false)
  canManageRoles     Boolean @default(false)
  canViewSalary      Boolean @default(false)
  canManageAdmins    Boolean @default(false)

  // Yangi ruxsatlar (Feature-gated)
  canViewKpi               Boolean @default(false) // KPI ko'rsatkichlarini ko'rish
  canManageBranches        Boolean @default(false) // Filiallarni boshqarish
  canManageNotifications   Boolean @default(false) // Bot bildirishnomalarini boshqarish
  canViewExpenseCharts     Boolean @default(false) // Chiqim tahlil grafiklarini ko'rish
  canViewSettings          Boolean @default(false) // Sozlamalar sahifasiga kirish
  canAssignToOtherBranches Boolean @default(false) // Boshqa filial xodimlariga vazifa berish
  canManageBilling         Boolean @default(false) // Obuna va to'lovlarni boshqarish
  canViewVendors           Boolean @default(false) // Hamkorlar va subpudratchilarni ko'rish

  // Yangi qo'shilgan granular ruxsatlar
  canViewStatistics        Boolean @default(false)
  canViewFinanceReports    Boolean @default(false) // Moliyaviy Dinamika grafigi
  canViewServiceReports    Boolean @default(false) // Xizmat Hajmi & O'rtacha Chek
  canViewRoles             Boolean @default(false)
  canManageExpenseTypes    Boolean @default(false)
  canManageKanbanColumns   Boolean @default(false)
  canManageGeneralSettings Boolean @default(false)

  // Hisobotlar saxifasi — har bo'lim uchun alohida ruxsat
  canViewGrowthCards    Boolean @default(false) // O'sish ko'rsatkichlari kartochkalari
  canViewIncomeByType   Boolean @default(false) // Kirim Turlari doira diagrammasi
  canViewExpenseByType  Boolean @default(false) // Chiqim Turlari doira diagrammasi
  canViewCostCalculator Boolean @default(false) // Tannarx Kalkulyatori

  // Mijozlar sahifasi — granular
  canAddCustomer    Boolean @default(false)
  canEditCustomer   Boolean @default(false)
  canDeleteCustomer Boolean @default(false)

  // Xodimlar sahifasi — granular
  canAddEmployee           Boolean @default(false)
  canEditEmployee          Boolean @default(false)
  canDeleteEmployee        Boolean @default(false)
  canResetEmployeePassword Boolean @default(false)

  // Ombor sahifasi — granular
  canAddInventoryItem  Boolean @default(false) // Yangi material nomi qo'shish
  canReceiveInventory  Boolean @default(false) // Kirim kiritish
  canUseInventory      Boolean @default(false) // Sarflanish/chiqim kiritish
  canWriteOffInventory Boolean @default(false) // Brak — hisobdan chiqarish

  // Hamkorlar va Filiallar
  canManageVendors Boolean @default(false) // Hamkorlarni CRUD + to'lov
  canViewBranches  Boolean @default(false) // Filiallar ro'yxatini ko'rish

  // Obuna
  canViewBillingStatus Boolean @default(false) // Obuna holati ko'rish (manage siz)

  // Kanban ko'rinish ruxsatlari (tasks:view_all / tasks:view_own)
  canViewAllTasks Boolean @default(false) // Barcha topshiriqlarni ko'rish
  canViewOwnTasks Boolean @default(false) // Faqat o'ziga biriktirilgan topshiriqlarni ko'rish

  // Excel eksport ruxsatlari — har bir sahifa uchun alohida
  canExportFinance    Boolean @default(false) // Kassa tranzaksiyalari
  canExportTasks      Boolean @default(false) // Topshiriqlar (Kanban)
  canExportCustomers  Boolean @default(false) // Mijozlar bazasi
  canExportInventory  Boolean @default(false) // Ombor materiallar
  canExportEmployees  Boolean @default(false) // Xodimlar ro'yxati
  canExportAttendance Boolean @default(false) // Davomat hisoboti
  canExportVendors    Boolean @default(false) // Hamkorlar
  canExportReports    Boolean @default(false) // Hisobotlar (BI)

  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([branchId])
}

model Employee {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fullName        String
  phone           String?
  login           String
  passwordHash    String // bcrypt hash — plaintext parol saqlanmaydi
  telegramId      String?
  deviceId        String? // Davomat anti-cheat uchun qurilma ID
  passwordVersion Int     @default(1) // Har safar parol o'zgarganda +1 (forced logout uchun)
  isFirstLogin    Boolean @default(true) // Birinchi marta kirganda malumotlarni tahrirlashni majburlash uchun

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  baseSalary  Float @default(0)
  givenAmount Float @default(0)
  workDebt    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskHistories     TaskHistory[]
  attendanceRecords AttendanceRecord[]
  overtimeRequests  OvertimeRequest[]
  transactions      Transaction[]

  @@unique([tenantId, login])
  @@index([tenantId])
}

// =============================================
// MIJOZLAR (Customers)
// =============================================

model Customer {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String // Company / Organization name
  phone       String? // Primary company phone (kept for backwards compat)
  companyInfo String? // Extra info: INN, address, etc. (JSON or plain text)
  totalDebt   Float   @default(0)
  totalPaid   Float   @default(0)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  contacts     CustomerContact[]
  transactions Transaction[]
  tasks        Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// =============================================
// B2B: Kompaniya kontakt shaxslari
// =============================================

model CustomerContact {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String?
  phone     String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([customerId])
}

// =============================================
// HAMKORLAR / SUBPUDRATCHILAR (Vendors)
// =============================================

model Vendor {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Strict branch isolation — Vendors are owned by exactly one Branch.
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name  String
  phone String?

  // Rol-teglar (ko'p tanlovli): "xomashyo" | "xizmat" | "xaridor".
  // Faqat yorliq/filtr uchun — pul yo'nalishini cheklamaydi.
  roles String[] @default([])

  // Relations
  tasks            Task[]
  transactions     Transaction[]
  orderVendorCosts OrderVendorCost[]
  vendorOrders     VendorOrder[]
  ledgerEntries    VendorLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
}

// =============================================
// VENDOR LEDGER ENTRY — Naqdsiz qarz/haqdorlik yozuvi
// Buyurtmaga ham, kassaga ham bog'lanmagan qo'lda kiritma:
//   direction = "we_owe"  → biz hamkordan xomashyo/xizmat oldik (qarzdormiz)
//   direction = "they_owe" → hamkor bizdan oldi (u bizga qarzdor)
// Naqd pul harakati Kassada (Transaction) qoladi; bu jadval faqat
// majburiyatni qayd etadi. Balans formulasi ikkalasini birlashtiradi.
// =============================================
model VendorLedgerEntry {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  direction   String // "we_owe" | "they_owe"
  amount      Float
  description String?
  date        DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([branchId])
  @@index([vendorId])
}

model OrderVendorCost {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  amount      Float
  description String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([taskId])
  @@index([vendorId])
}

// =============================================
// MOLIYA (Finance)
// =============================================

model PaymentType {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String // 'Naqd', 'Karta' va h.k.
  transactions Transaction[]
  tasks        Task[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Transaction {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type   String // 'kirim' | 'chiqim'
  date   DateTime @default(now())
  amount Float

  // To'lov turi
  paymentTypeId String?
  paymentType   PaymentType? @relation(fields: [paymentTypeId], references: [id])

  // Kirim uchun
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String? // Ro'yxatdan o'tmagan (noma'lum) mijoz ismi
  serviceType  String?
  taskId       String? // Agar taskdan zakolat bo'lsa

  // Chiqim uchun
  expenseReason String?
  expenseTypeId String?
  expenseType   ExpenseType? @relation(fields: [expenseTypeId], references: [id])
  employeeId    String?
  employee      Employee?    @relation(fields: [employeeId], references: [id])

  // Hamkor (subpudratchi) bog'liq
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  // Filial bog'liq
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([departmentId])
}

model ExpenseType {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name         String
  transactions Transaction[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// =============================================
// KANBAN & TASKS
// =============================================

model KanbanColumn {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title    String
  orderIdx Int    @default(0)
  tasks    Task[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
}

model Task {
  id        String  @id @default(uuid())
  displayId String? // e.g. YC-10001 — human-readable per-customer sequence
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderName   String? // Buyurtma nomi (Masalan: Mega Meva)
  title       String
  description String?

  // Mijoz ma'lumotlari
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  customerName  String? // Yangi mijoz bo'lsa yoki backup
  customerPhone String?

  // Xizmat (Pricing Engine)
  serviceId      String? // Qaysi xizmat asosida
  service        Service? @relation(fields: [serviceId], references: [id])
  serviceOptions String   @default("[]") // JSON: tanlangan option ID lar
  quantity       Int      @default(1)
  coefficient    Float    @default(1.0)

  // Variant qatorlari (rang/o'lcham ajratmasi) — agar Service.variantAxes mavjud bo'lsa.
  // Format: [{ "atributlar": { "Rang": "Oq", "O'lcham": "M" }, "soni": 30 }, ...]
  // quantity = sum(variants.soni). Bo'sh/null bo'lsa — variantsiz buyurtma.
  variants       Json?

  // Moliyaviy qism
  totalAmount     Float @default(0) // Berilishi kerak bo'lgan summa
  depositAmount   Float @default(0) // Olingan summa (zakolat)
  remainingAmount Float @default(0) // Qoldiq summa

  paymentTypeId String?
  paymentType   PaymentType? @relation(fields: [paymentTypeId], references: [id])

  columnId String
  column   KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  assignees         String    @default("[]") // JSON: string array
  attachments       String    @default("[]") // JSON: image array
  materialOverrides String    @default("[]") // JSON: {materialId, quantity}[]
  deadlineAt        DateTime? // Topshiriq muddati (ixtiyoriy)

  isArchived Boolean @default(false) // true bo'lsa — o'chirilgan emas, arxivlangan

  branchId String?
  branch   Branch? @relation("OriginBranch", fields: [branchId], references: [id])

  // Bajaruvchi filial — null = o'zimiz bajaramiz, set = boshqa filiala topshirilgan
  executorBranchId String?
  executorBranch   Branch? @relation("ExecutorBranch", fields: [executorBranchId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Outsourcing / Vendor
  vendorId   String?
  vendor     Vendor? @relation(fields: [vendorId], references: [id])
  vendorCost Float?  @default(0)

  histories         TaskHistory[]
  stockMovements    StockMovement[]
  vendorCosts       OrderVendorCost[]
  expenses          TaskExpense[]
  attachmentRecords TaskAttachment[] // Yangi normalized model — har attachment alohida row.
  // Eski `attachments` JSON ustun migratsiyadan keyin
  // dropladi; hozir backward compat uchun ikkalasi turadi.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@index([tenantId, isArchived])
}

model SystemSetting {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key   String // JSON string
  value String

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TaskHistory {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  action  String // 'yaratildi', 'o'zgartirildi', 'ko'chirildi', 'ko'rildi'
  details String? // JSON yoki text: "Buyurtma olindi -> Dizayn"
  note    String? // Izoh

  createdAt DateTime @default(now())

  @@index([tenantId])
}

// =============================================
// TaskAttachment — Buyurtma fayllar (CDR, TIF, PDF).
// Eski `Task.attachments` JSON TEXT ustun o'rniga normalized jadval:
//   - Append = INSERT (kichik), UPDATE 30MB TEXT emas
//   - Delete bitta fayl = DELETE WHERE id, UPDATE emas
//   - Task list o'qiyotganda attachmentlar yuklanmaydi (separate relation)
//   - Race condition (ikki userning bir vaqtda upload qilishi) yo'q
//
// `data` — base64 data URL string (masalan: "data:application/x-coreldraw;base64,...").
// Bytea o'rniga TEXT tanlandi — frontend allaqachon data URL bilan ishlaydi,
// konvertatsiya kodi qo'shilmaydi. Hajmga ta'siri: ~33% inflyatsiya, lekin
// poligrafiya hajmida (yiliga ~20GB) Railway Pro tier'i bemalol ko'taradi.
// =============================================
model TaskAttachment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  name     String // Original fayl nomi (masalan: "design.cdr")
  mimeType String? // "image/tiff", "application/x-coreldraw" — frontend ekstension'dan ham aniqlay oladi
  data     String  @db.Text // base64 data URL ("data:...;base64,...")
  size     Int     @default(0) // Asl fayl hajmi (bayt) — base64'gacha

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([taskId])
}

// =============================================
// TASK EXPENSE — Buyurtma tannarxi xarajatlari
// Dynamic costing: yo'l kira, material, mehnat va boshqalar
// =============================================
// =============================================
// VENDOR ORDER — Hamkorga topshirilgan buyurtmalar
// Workflow: PENDING → ACCEPTED → COMPLETED
// =============================================
model VendorOrder {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  title  String // Buyurtma tavsifi
  amount Float   @default(0)
  note   String?

  status String @default("PENDING") // PENDING | ACCEPTED | COMPLETED

  sourceTaskId String? // Qaysi task dan yaratilgani (ixtiyoriy)
  taskId       String? // Qabul qilinganda yaratilgan kanban task ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

model TaskExpense {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  expenseName String // Xarajat turi: "Yo'l kira", "Qog'oz", "Mehnat haqi"
  amount      Float // UZS

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([taskId])
}

// =============================================
// SUPER-ADMIN TASK MANAGER (Voronka)
// Platform-level task tracker — fully separated from tenant Tasks.
// Used by PrintFlow super-admins to track their own sales / ops work.
// =============================================
model SuperAdminFunnel {
  id        String              @id @default(uuid())
  name      String
  color     String              @default("#FF6B00")
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  tasks     SuperAdminTaskItem[]
}

model SuperAdminTaskItem {
  id          String           @id @default(uuid())
  funnelId    String
  funnel      SuperAdminFunnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  title       String
  description String?
  deadlineAt  DateTime?
  status      String           @default("open") // open | in_progress | done
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([funnelId])
}
